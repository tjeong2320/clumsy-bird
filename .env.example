# Copy this file to `.env` and fill in real values from the Neon Console.
# https://docs.neonpay.com/docs/environments-and-api-keys

# Required: Neon API key for the environment you want to test against.
# Use your SANDBOX key while developing.

# Required: Shared secret you register your webhook listener with in the
# Neon Console. Used to validate the x-neon-digest HMAC-SHA256 signature.

# Optional. Defaults shown.
NEON_API_KEY=pk_sandbox_…
NEON_WEBHOOK_SECRET=<your-secret-key>

PORT=3000
PUBLIC_URL=https://<your-subdomain>.ngrok-free.dev

IS_SANDBOX=true
SANDBOX_IP=8.8.8.8
SANDBOX_LOCALE=en-US
